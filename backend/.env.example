# mock = dados gerados em memória | sqlite = banco populado com as tabelas Gold (quando estiver pronto)
DATA_SOURCE=mock
SQLITE_PATH=data/gold.db
# ordens de inspeção (banco do portal, separado da Gold)
PORTAL_DB_PATH=data/portal.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GEMINI_API_KEY=...
OPENROUTER_API_KEY=...
# confidential (padrão): bloqueia o Nemotron gratuito. synthetic: SOMENTE dados artificiais.
PROVIDER_PAYLOAD_POLICY=confidential

# C2: sem REDIS_URL, o cache fica desabilitado. Versão explícita do snapshot.
REDIS_URL=
GOLD_DATA_VERSION=gold-v1 #Se houver atualização mudamos pra uma new version
CACHE_TTL_SECONDS=86400
CACHE_MAX_ENTRIES_PER_SESSION=100
CACHE_TIMEOUT_SECONDS=1

# Observabilidade opcional: exige opt-in E write token. Nunca versionar o token real.
LOGFIRE_ENABLED=false
LOGFIRE_TOKEN=
LOGFIRE_SERVICE_NAME=v-energy-grid-360-backend
# Opcional; sem override, o SDK identifica a região pelo token.
LOGFIRE_BASE_URL=
MEMORY_TTL_SECONDS=86400
MEMORY_TIMEOUT_SECONDS=1

# Reescrita dos insights do portal com IA (0 = desligada, 1 = ligada)
INSIGHTS_LLM=1